# ==============================================================================
# AeroVault Backend Environment Configuration
# ==============================================================================

# Server Host, Port & Environment
HOST=0.0.0.0
PORT=4000
NODE_ENV=development

# Neon PostgreSQL Database Connection URL
# Pooling URL (Recommended for high-concurrency serverless/REST API queries via PgBouncer):
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-cool-dawn-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct URL (Optional: used for Prisma CLI schema migrations if needed):
# DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-cool-dawn-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Debug / Logging flags
DEBUG_PRISMA=false

# Allowed CORS Origins (Comma-separated for multiple origins, or single domain in production)
CORS_ORIGIN="http://localhost:5173,https://aerovault.vercel.app"

# Admin API Key for authenticated administrative write routes (POST/PUT/DELETE)
ADMIN_API_KEY="aerovault_secure_admin_key_2026"
