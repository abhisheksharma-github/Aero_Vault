# ==============================================================================
# AeroVault Frontend (Vite) Environment Configuration
# ==============================================================================

# Backend API Base URL
# In local development with Vite proxy, '/api' is used.
# In production on Vercel/Netlify, set this to your deployed Render/Railway backend URL:
# Example: VITE_API_BASE_URL=https://aerovault-api.onrender.com/api
VITE_API_BASE_URL=/api
